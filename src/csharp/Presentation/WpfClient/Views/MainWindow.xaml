<Window x:Class="GameAssistant.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameAssistant.WpfClient"
        mc:Ignorable="d"
        Title="Game Assistant" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged">
    <Grid Margin="10">
        <StackPanel>
            <Button Content="Capture and OCR (Ctrl+Alt+G)" 
                    Click="CaptureButton_Click" 
                    Height="30" 
                    Margin="0,0,0,10"/>
            <Button Content="Minimize to Tray" 
                    Click="MinimizeToTrayButton_Click" 
                    Height="25" 
                    Margin="0,0,0,10"/>
            <TextBox x:Name="ResultBox" 
                     TextWrapping="Wrap" 
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" 
                     Height="300"/>
        </StackPanel>
    </Grid>
</Window>

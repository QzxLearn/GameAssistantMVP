<Window x:Class="GameAssistant.WpfClient.Views.TrainingDataCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrainingDataCaptureWindow" Height="501" Width="970">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标签页 -->
        <TabControl Grid.Row="0" Margin="0,0,0,10">

            <!-- 标签 1: 新采集 -->
            <TabItem Header="📸 新采集">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <Button Content="📸 捕获卡牌" Click="CaptureButton_Click"
                            Width="120" Height="35" FontSize="14"
                            Margin="0,0,10,0" Background="#4CAF50" Foreground="White"/>
                    <ComboBox x:Name="GameTypeComboBox" Width="150" Height="35" FontSize="14"
                              SelectedIndex="0" Margin="0,0,10,0">
                        <ComboBoxItem Content="SlayTheSpire"/>
                        <ComboBoxItem Content="MonsterTrain"/>
                        <ComboBoxItem Content="自定义"/>
                    </ComboBox>
                    <ComboBox x:Name="CardTypeComboBox" Width="120" Height="35" FontSize="14"
                              SelectedIndex="0" Margin="0,0,10,0">
                        <ComboBoxItem Content="Attack"/>
                        <ComboBoxItem Content="Skill"/>
                        <ComboBoxItem Content="Power"/>
                        <ComboBoxItem Content="Curse"/>
                    </ComboBox>
                    <TextBlock Text="📸 已采集：" VerticalAlignment="Center" FontSize="14"/>
                    <TextBlock x:Name="CountTextBlock" Text="0" FontWeight="Bold"
                               VerticalAlignment="Center" FontSize="16" Margin="5,0,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- 标签 2: 历史记录 ⭐ 新增 -->
            <TabItem Header="📋 历史记录">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 刷新" Click="RefreshHistory_Click" Width="80" Margin="0,0,10,0"/>
                        <Button Content="🗑️ 清空" Click="ClearHistory_Click" Width="80" Margin="0,0,10,0"/>
                        <ComboBox x:Name="HistoryGameFilter" Width="150" Height="30" 
                                  SelectionChanged="HistoryGameFilter_SelectionChanged"
                                  Margin="0,0,10,0">
                            <ComboBoxItem Content="全部游戏"/>
                            <ComboBoxItem Content="SlayTheSpire"/>
                            <ComboBoxItem Content="MonsterTrain"/>
                        </ComboBox>
                        <TextBlock Text="共 " VerticalAlignment="Center"/>
                        <TextBlock x:Name="HistoryCountText" Text="0" 
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" 条记录" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 历史记录列表 -->
                    <DataGrid Grid.Row="1" x:Name="HistoryDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionChanged="HistoryDataGrid_SelectionChanged"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" 
                                                Width="150"/>
                            <DataGridTextColumn Header="游戏" Binding="{Binding GameName}" 
                                                Width="120"/>
                            <DataGridTextColumn Header="卡牌类型" Binding="{Binding CardType}" 
                                                Width="80"/>
                            <DataGridTextColumn Header="OCR 结果" Binding="{Binding OcrResult}" 
                                                Width="200"/>
                            <DataGridCheckBoxColumn Header="已审查" Binding="{Binding IsReviewed}" 
                                                    Width="60"/>
                            <DataGridTextColumn Header="置信度" Binding="{Binding Confidence}" 
                                                Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 标签 3: 已标注数据 ⭐ 新增 -->
            <TabItem Header="🏷️ 已标注数据">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 刷新" Click="RefreshAnnotations_Click" Width="80" Margin="0,0,10,0"/>
                        <ComboBox x:Name="AnnotationGameFilter" Width="150" Height="30" 
                                  SelectionChanged="AnnotationGameFilter_SelectionChanged"
                                  Margin="0,0,10,0">
                            <ComboBoxItem Content="全部游戏"/>
                            <ComboBoxItem Content="SlayTheSpire"/>
                            <ComboBoxItem Content="MonsterTrain"/>
                        </ComboBox>
                        <Button Content="📤 导出" Click="ExportAnnotations_Click" 
                                Width="80" Background="#FF9800" Foreground="White"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="AnnotationDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionChanged="AnnotationDataGrid_SelectionChanged"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" 
                                                Width="150"/>
                            <DataGridTextColumn Header="游戏" Binding="{Binding GameType}" 
                                                Width="120"/>
                            <DataGridTextColumn Header="卡牌名" Binding="{Binding CardName}" 
                                                Width="150"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding CardType}" 
                                                Width="80"/>
                            <DataGridCheckBoxColumn Header="已验证" Binding="{Binding IsVerified}" 
                                                    Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 主工作区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- 图像预览区 -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="5" Margin="5" Background="#FAFAFA">
                <Viewbox Stretch="Uniform">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="None"/>
                        <Canvas x:Name="AnnotationCanvas"
                                Background="Transparent"
                                IsHitTestVisible="True"
                                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                MouseMove="Canvas_MouseMove"
                                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                                Cursor="Arrow"/>
                    </Grid>
                </Viewbox>
            </Border>

            <!-- 编辑面板 -->
            <ScrollViewer Grid.Column="1" Margin="15,0,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0">

                    <!-- 工作状态显示 ⭐ 新增 -->
                    <GroupBox Header="📊 上一次工作状态" Margin="0,0,0,10">
                        <StackPanel Margin="5">
                            <TextBlock x:Name="LastSessionTime" Text="时间：-" 
                                       FontSize="12" Margin="0,2"/>
                            <TextBlock x:Name="LastSessionGame" Text="游戏：-" 
                                       FontSize="12" Margin="0,2"/>
                            <TextBlock x:Name="LastSessionOcr" Text="OCR：-" 
                                       FontSize="12" Margin="0,2" 
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="LastSessionStatus" Text="状态：未审查" 
                                       FontSize="12" Margin="0,2"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </GroupBox>

                    <Separator Margin="0,10"/>

                    <!-- 标注管理 -->
                    <TextBlock Text="🏷️ 标注管理" FontWeight="Bold" FontSize="16"
                               Margin="0,0,0,10"/>
                    <GroupBox Header="标注区域列表" Margin="0,0,0,10">
                        <ListBox x:Name="AnnotationListBox"
                                 Height="150"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="AnnotationListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Margin="2">
                                        <TextBlock FontWeight="Bold" FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Text}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, Converter={StaticResource IsNullOrEmptyConverter}}" Value="True">
                                                            <Setter Property="Text" Value="{Binding Id, StringFormat=区域 {0}}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontSize="10" Foreground="Gray" HorizontalAlignment="Right">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}%">
                                                    <Binding Path="Confidence"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>

                    <Button Content="➕ 添加标注区域" Click="AddAnnotation_Click"
                            Height="35" Margin="0,0,0,10" Background="#FF9800" Foreground="White"/>
                    <Button Content="🗑️ 删除选中" Click="DeleteAnnotation_Click"
                            Height="35" Margin="0,0,0,10" Background="#F44336" Foreground="White"/>

                    <Separator Margin="0,10"/>

                    <!-- 卡牌信息编辑 -->
                    <TextBlock Text="📝 卡牌信息" FontWeight="Bold" FontSize="14"
                               Margin="0,15,0,5"/>
                    <TextBox x:Name="CardNameTextBox" Height="35" FontSize="16"
                             TextChanged="CardNameTextBox_TextChanged"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="🏷️ 选中区域文本" FontWeight="Bold" FontSize="14"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="SelectedAnnotationTextBox" Height="35" FontSize="14"
                             TextChanged="SelectedAnnotationTextBox_TextChanged"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="📝 描述文本" FontWeight="Bold" FontSize="14"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="DescriptionTextBox" Height="80"
                             TextWrapping="Wrap" AcceptsReturn="True" FontSize="14"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="🔍 置信度" FontWeight="Bold" FontSize="14"
                               Margin="0,0,0,5"/>
                    <Slider x:Name="ConfidenceSlider" Minimum="0" Maximum="100"
                            Value="100" TickFrequency="10" IsSnapToTickEnabled="True"
                            Margin="0,0,0,5"/>
                    <TextBlock x:Name="ConfidenceText" Text="100%"
                               HorizontalAlignment="Right" FontSize="12" Foreground="Gray"/>

                    <CheckBox x:Name="IsVerifiedCheckBox" Content="✅ 已人工验证"
                              Margin="0,10,0,0" FontSize="14"/>

                    <!-- 操作按钮 -->
                    <Button Content="💾 保存标注" Click="SaveAnnotation_Click"
                            Height="40" Margin="0,20,0,0"
                            Background="#4CAF50" Foreground="White" FontSize="16"/>

                    <!-- 历史记录编辑按钮 ⭐ 新增 -->
                    <Button x:Name="SaveHistoryEditButton" Content="💾 保存编辑" Click="SaveHistoryEdit_Click"
                            Height="40" Margin="0,10,0,0"
                            Background="#2196F3" Foreground="White" FontSize="16"
                            Visibility="Collapsed"/>
                    <Button x:Name="DeleteHistoryButton" Content="🗑️ 删除记录" Click="DeleteHistory_Click"
                            Height="40" Margin="0,10,0,0"
                            Background="#F44336" Foreground="White" FontSize="16"
                            Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="2" Background="#212121" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="准备中..."/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="📤 导出为训练集" Click="ExportButton_Click"
                        Width="140" Height="30"
                        Background="#FF9800" Foreground="White"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
<Application x:Class="GameAssistant.WpfClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameAssistant.WpfClient">
    <!-- 正确做法：将托盘图标定义为资源 -->
    <Application.Resources>
        <DrawingImage x:Key="TrayIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="CornflowerBlue">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry RadiusX="8" RadiusY="8" Center="8,8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Application.Resources>
</Application>
